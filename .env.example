# Salin ke frontend/.env.local untuk development. JANGAN commit file .env asli.
# Nilai di bawah cukup untuk Firebase Emulator (tanpa project Firebase sungguhan).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-complaint-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-complaint-hub
VITE_FIREBASE_STORAGE_BUCKET=demo-complaint-hub.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id

# true = sambungkan ke Firebase Emulator
VITE_USE_EMULATORS=true

